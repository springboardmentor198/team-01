# Copy these values into your shell environment or a local, ignored configuration file.
DB_URL=jdbc:postgresql://localhost:5432/real_estate_dd
DB_USERNAME=postgres
DB_PASSWORD=replace-with-your-local-postgresql-password
JWT_SECRET=replace-with-a-32-byte-or-longer-random-development-secret
FRONTEND_URL=http://localhost:5173
SERVER_PORT=8081

# Optional email and Google OAuth integrations
MAIL_USERNAME=your-email@example.com
MAIL_PASSWORD=your-email-app-password
MAIL_FROM=your-email@example.com
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
